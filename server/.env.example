# Copy this file to .env and change the values to match your PostgreSQL setup.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appdrello
# Set to true for hosted databases that require SSL (most of them do)
DATABASE_SSL=false
PORT=3000
# The address(es) of the Angular app, allowed to call the API. Several? Separate with commas.
CLIENT_ORIGIN=http://localhost:4200
# The app's address used in links inside emails
APP_URL=http://localhost:4200
# Secret used to sign login tokens. Use a long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value

# ---------- Sending email (for "Forgot password") ----------
# Email. The server uses the first of these that is filled in:
# 1. Brevo (free, works on any hosting): BREVO_API_KEY from app.brevo.com → SMTP & API → API keys.
#    EMAIL_FROM must be a sender you have verified in Brevo.
BREVO_API_KEY=
# 2. SMTP, e.g. Gmail on your own computer.
# Leave everything empty to print emails in this terminal instead of sending them.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
#        SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The sender shown in the email, e.g.: Drello <your.address@gmail.com>
EMAIL_FROM=
